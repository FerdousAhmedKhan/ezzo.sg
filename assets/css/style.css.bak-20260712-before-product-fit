.btn-155 {
	background: #00a1ff;
	color: white;
	font-size: 14px;
	border-radius: 999px;
	border: none;
	letter-spacing: 1px;
	padding: 13px 50px 13px 13px;
	overflow: hidden;
	position: relative;
	cursor: pointer;
	text-decoration: none;
	user-select: none;
	display: inline-flex;
	justify-content: center;
	align-items: center;
	font-weight: bold;
	background-image: radial-gradient(circle at center center, #247194, #19495f);
}

.btn-155 .button-icon {
	background: #ffffff;
	position: absolute;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 40px;
	border-radius: 999px;
	right: 5px;
	top: 5px;
	bottom: 5px;
	transition: all 0.3s;
}

.btn-155:hover .button-icon {
	width: calc(100% - 10px);
}

.btn-155 .button-icon svg {
	width: 1.1em;
	transition: transform 0.3s;
	color: #000000;
}

.btn-155:hover .button-icon svg {
	transform: translateX(0.1em);
}

.btn-155:active .button-icon {
	transform: scale(0.95);
}
